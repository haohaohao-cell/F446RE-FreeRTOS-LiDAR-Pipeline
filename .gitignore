# ---- build output -----------------------------------------------------------
# Everything under Debug/ and Release/ is regenerated by STM32CubeIDE.
# Only the sources and the project files are versioned.
Debug/
Release/
*.o
*.d
*.su
*.cyclo
*.elf
*.map
*.list
*.bin
*.hex

# ---- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# ---- runtime logs produced by tools/*.cmd -------------------------------
tools/logs/

# ---- host unit-test binaries (tools/host_tests, see its README) ---------
tools/host_tests/*.exe

# ---- OS / editor noise --------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
*.swp
.vscode/

# ---- temporary render/preview directories -------------------------------
.dsh-office-*/
